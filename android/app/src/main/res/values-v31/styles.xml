<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ 系统启动画面：底色跟自家启动页一致，图标换透明，
         免得进 App 前先弹一下应用图标 -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowSplashScreenBackground">#12121F</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowBackground">#12121F</item>
    </style>
</resources>
